generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model alerts {
  id                  Int            @id @default(autoincrement())
  name                String?
  deviceId            Int
  operator            String
  value               Int
  bitwiseOperator     String
  readingBeforeAlerts Int
  device              device         @relation(fields: [deviceId], references: [id], map: "Alerts_deviceId_fkey")
  autodownlink        autodownlink?
  notification        notification[]

  @@index([deviceId], map: "Alerts_deviceId_idx")
}

model autodownlink {
  id                 Int      @id @default(autoincrement())
  alertId            Int      @unique(map: "AutoDownlink_alertId_key")
  timeout            Int?
  schedule           Int?
  port               Int
  downlinkController String
  classType          String
  devEui             String
  pdu                String
  createdAt          DateTime @default(now())
  alerts             alerts   @relation(fields: [alertId], references: [id], map: "AutoDownlink_alertId_fkey")

  @@index([alertId], map: "AutoDownlink_alertId_idx")
}

model customer {
  id                   Int            @id @default(autoincrement())
  firstName            String         @db.VarChar(50)
  lastName             String         @db.VarChar(50)
  image                String?        @db.VarChar(255)
  companyName          String?        @db.VarChar(100)
  password             String         @db.VarChar(255)
  countryCode          String         @db.VarChar(10)
  phoneNumber          String         @db.VarChar(20)
  email                String         @unique(map: "Customer_email_key") @db.VarChar(100)
  role                 String         @default("customer")
  createdAt            DateTime       @default(now())
  isDeleted            Boolean        @default(false)
  isVerified           Boolean        @default(false)
  isOrgnizationCreated Boolean        @default(false)
  organization         organization[]
  projects             projects[]

  networkdata networkdata[]
}

model deviceattribute {
  id       Int    @id @default(autoincrement())
  name     String
  value    String
  deviceId Int
  device   device @relation(fields: [deviceId], references: [id], map: "DeviceAttribute_deviceId_fkey")

  @@index([deviceId], map: "DeviceAttribute_deviceId_fkey")
}

model devicedecodedata {
  id              Int      @id @default(autoincrement())
  devEui          String
  attributesName  String
  attributesValue String
  timestamp       DateTime @default(now())
  deviceId        Int?
  attributesUnits String?
}

