model deviceserverdata {
  id          Int      @id @default(autoincrement())
  devEui      String   // Common field: SenRa (devEui), Loriot (EUI)
  seqno       Int      // Common field
  port        Int      // Common field
  ack         Boolean  // Common field
  pdu         String   // Common field: SenRa (pdu), Loriot (encdata or data)
  txtime      DateTime // Common field: SenRa (txtime), Loriot (ts)
  serverName  String   @default("null")// Name of the platform (e.g., "SenRa", "Loriot")// this will be set in the mapping that we will create in the mapping funstion for the native thing

  // SenRa specific fields
  joinId      Int?     // SenRa only
  gwEui       String?  // SenRa only
  rssi        Int?     // SenRa only
  snr         Float?   // SenRa only
  freq        Float?   // SenRa only
  channel     Int?     // SenRa only
  datarate    Int?     // SenRa only
  dup         Boolean? // SenRa only
  estLat      Float?   // SenRa only
  estLng      Float?   // SenRa only
  cfgLat      Float?   // SenRa only
  cfgLng      Float?   // SenRa only
  devClass    String?  // SenRa only
  devType     String?  // SenRa only
  devProfile  String?  // SenRa only
  metadata    String?  // SenRa only
  ackDnMsgId  Int?     // SenRa only
  ackDnSeqNo  Int?     // SenRa only

  // Loriot specific fields
  bat         Int?     // Loriot only (battery status)
  fcnt        Int?     // Loriot only (frame counter)
  offline     Boolean? // Loriot only (connection status)
  decodedData Json?    // Loriot only (decoded payload)
}


model downlinkdevice {
  id                 Int      @id @default(autoincrement())
  devEui             String
  downlinkController String
  classType          String
  pdu                String
  confirmed          Boolean  @default(false)
  timeoutMinutes     Int
  port               String
  payload            String
  deviceId           Int?
  device             device?  @relation(fields: [deviceId], references: [id], map: "DownlinkDevice_deviceId_fkey")
  createdAt          DateTime @default(now())

  @@index([deviceId], map: "DownlinkDevice_deviceId_fkey")
}

model hardware {
  id                 Int                  @id @default(autoincrement())
  organizationId     Int                  @default(0)
  imageKey           String?
  imageLocation      String?
  name               String
  type               String
  description        String?
  modelNo            String 
  manufacturerId     Int
  tagId              Int
  gpsSupported       Boolean              @default(true)
  configured         Boolean
  createdAt          DateTime             @default(now())
  decoderName        String
  device             device[]
  hardwareattributes hardwareattributes[]
  hardwareoutput     hardwareoutput[]
}

model hardwareattributes {
  id         Int      @id @default(autoincrement())
  key        String
  value      String
  hardwareId Int
  hardware   hardware @relation(fields: [hardwareId], references: [id], map: "HardwareAttributes_hardwareId_fkey")

  @@index([hardwareId], map: "HardwareAttributes_hardwareId_fkey")
}

model hardwareoutput {
  id         Int      @id @default(autoincrement())
  hardwareId Int
  outputId   Int
  createdAt  DateTime @default(now())
  hardware   hardware @relation(fields: [hardwareId], references: [id], map: "HardwareOutput_hardwareId_fkey")
  output     output   @relation(fields: [outputId], references: [id], map: "HardwareOutput_outputId_fkey")

  @@index([hardwareId], map: "HardwareOutput_hardwareId_fkey")
  @@index([outputId], map: "HardwareOutput_outputId_fkey")
}

model notification {
  id        Int      @id @default(autoincrement())
  message   String
  deviceId  Int
  alertId   Int?
  createdAt DateTime @default(now())
  alerts    alerts?  @relation(fields: [alertId], references: [id], map: "Notification_alertId_fkey")
  device    device   @relation(fields: [deviceId], references: [id], map: "Notification_deviceId_fkey")

  @@index([alertId], map: "Notification_alertId_fkey")
  @@index([deviceId], map: "Notification_deviceId_idx")
}

model organization {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(100)
  description String   @db.VarChar(255)
  createdAt   DateTime @default(now())
  customerId  Int
  device      device[]
  customer    customer @relation(fields: [customerId], references: [id], map: "Organization_customerId_fkey")

  @@index([customerId], map: "Organization_customerId_idx")
}

model output {
  id             Int              @id @default(autoincrement())
  deviceId       Int
  name           String
  unit           String
  type           String
  description    String
  linkedTo       String // New column for linking the relay to devices like AC or Lightbulb
  device         device           @relation(fields: [deviceId], references: [id])
  hardwareoutput hardwareoutput[] @relation(map: "HardwareOutput_outputId_fkey")
}

model projects {
  id         Int         @id @default(autoincrement())
  name       String      @db.VarChar(100)
  solutions  String      @db.VarChar(255)
  area       String      @db.VarChar(100)
  setLimit   Int
  createdAt  DateTime    @default(now())
  customerId Int
  estLat     Float
  estLng     Float
  device     device[]
  customer   customer    @relation(fields: [customerId], references: [id], map: "Projects_customerId_fkey")
  addWidget  addwidget[]

  @@index([customerId], map: "Projects_customerId_idx")
}

model timezone {
  id     Int    @id @default(autoincrement())
  name   String @db.VarChar(100)
  offset Int?
}

model device {
  id                 Int    @id @default(autoincrement())
  name               String
  manufacture        String
  deviceLocation     String
  currentLocation    String
  hardwareId         Int
  networkId          Int
  organizationId     Int
  projectId          Int
  hardwareOutputId   Int?
  deviceId           String @unique
  location           String
  hardwareType       String @default("LoraWan")
  network            String @default("SENRA")
  deviceLocationName String @db.VarChar(255)

  alerts          alerts[]
  hardware        hardware          @relation(fields: [hardwareId], references: [id], map: "Device_hardwareId_fkey")
  organization    organization      @relation(fields: [organizationId], references: [id], map: "Device_organizationId_fkey")
  projects        projects          @relation(fields: [projectId], references: [id], map: "Device_projectId_fkey")
  deviceattribute deviceattribute[]
  downlinkdevice  downlinkdevice[]
  notification    notification[]
  output          output[]

  @@index([hardwareId], map: "Device_hardwareId_fkey")
  @@index([organizationId], map: "Device_organizationId_idx")
  @@index([projectId], map: "Device_projectId_idx")
}

model autodownlinkwithdelay {
  id                 Int      @id @default(autoincrement())
  downlinkController String
  isActive           Boolean
  timeoutMinutes     Int
  classType          String
  port               Int
  deviceId           Int
  devEui             String
  pdu                String
  isProcessing       Boolean  @default(false) // Default value
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// above code is for the previous git push

model addwidget {
  id            Int      @id @default(autoincrement())
  pageName      String // The name of the page this widget is associated with
  stepOneData   Json // JSON field to store step 1 data
  stepTwoData   Json // JSON field to store step 2 data
  stepThreeData Json // JSON field to store step 3 data
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  projectId     Int // Foreign key to Project table
  projects      projects @relation(fields: [projectId], references: [id]) // Establishes the relationship
}

model pages {
  id        Int      @id @default(autoincrement())
  pageName  String
  projectId Int
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
}

model tokenblacklist {
  id        Int      @id @default(autoincrement())
  token     String   @unique @db.VarChar(512)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

enum ConditionOperator {
  EQ // Equal To (=)
  GTE // Greater than or equal to (>=)
  LTE // Less than or equal to (<=)
  GT // Greater than (>)
  LT // Less than (<)
}

model Label {
  id          Int     @id @default(autoincrement())
  name        String // The name of the label
  description String? // Optional description for the label
  color       String // Color associated with the label (e.g., HEX code)

  projectId         Int
  deviceId          Int
  outputId          Int
  outputName        String
  conditionValue    Int // Integer value for the condition
  conditionOperator ConditionOperator // Enum value for the operator (EQ, >=, <=, >, <)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model loriotuplinkmessage {
  id        Int      @id @default(autoincrement())
  cmd       String
  seqno     Int
  EUI       String
  ts        BigInt
  ack       Boolean
  bat       Float
  fcnt      BigInt
  port      Int
  offline   Boolean
  encdata   String? // Nullable as it is optional
  data      String? // Nullable as it is optional
  decoded   Json? // Storing decoded as JSON since its structure may vary
  createdAt DateTime @default(now())
}

model networkmodel {
  id          Int           @id @default(autoincrement())
  name        String        @db.VarChar(100)
  networkdata networkdata[]
}

model networkdata {
  id         Int          @id @default(autoincrement())
  networkId  Int
  urlString  String?
  hostname   String?
  token      String?
  customerId Int
  customer customer @relation(fields: [customerId], references: [id])
  updatedAt  DateTime     @updatedAt
  network    networkmodel @relation(fields: [networkId], references: [id])
  createdAt  DateTime     @default(now())
}
